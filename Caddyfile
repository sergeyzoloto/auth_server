# TLS termination and path filtering in front of Keycloak.
# Public: only what OIDC clients and login pages need.
# Admin console and the master realm: only from ADMIN_ALLOWED_IPS, 404 for everyone else.
{
	email {$ACME_EMAIL}
}

{$AUTH_HOSTNAME} {
	@admin path /admin /admin/* /realms/master /realms/master/*
	handle @admin {
		@trusted remote_ip {$ADMIN_ALLOWED_IPS}
		handle @trusted {
			reverse_proxy keycloak:8080
		}
		respond 404
	}

	@public path /realms/* /resources/* /.well-known/* /robots.txt
	handle @public {
		reverse_proxy keycloak:8080
	}

	handle {
		respond 404
	}
}
