{
  "realm": "myapps",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 10,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "roles": {
    "realm": [
      { "name": "user", "description": "Base role shared by every project in this realm" }
    ],
    "client": {
      "shop-api": [
        { "name": "user" },
        { "name": "admin" }
      ],
      "blog-api": [
        { "name": "user" },
        { "name": "admin" }
      ],
      "admin-app": [
        { "name": "user" },
        { "name": "admin" }
      ]
    }
  },
  "clients": [
    {
      "clientId": "shop-api",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": ["https://shop.example.com/*"],
      "webOrigins": ["+"],
      "attributes": { "post.logout.redirect.uris": "https://shop.example.com/*" }
    },
    {
      "clientId": "blog-api",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": ["https://blog.example.com/*"],
      "webOrigins": ["+"],
      "attributes": { "post.logout.redirect.uris": "https://blog.example.com/*" }
    },
    {
      "clientId": "admin-app",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "redirectUris": ["https://admin.example.com/*"],
      "webOrigins": ["+"],
      "attributes": { "post.logout.redirect.uris": "https://admin.example.com/*" }
    }
  ]
}
