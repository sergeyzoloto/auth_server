# Copy to .env and fill in. .env is gitignored — never commit it.
# Wrap any value containing $ in single quotes (DB_PASSWORD='pa$word'):
# unquoted, compose reads $NAME as a variable and silently drops it.

# --- Public endpoint -------------------------------------------------------
# DNS name of the auth server. Its A/AAAA record must already point at this
# host before the first start, or Let's Encrypt can't issue the certificate.
AUTH_HOSTNAME=auth.example.com
# Let's Encrypt account email (expiry and problem notices).
ACME_EMAIL=ops@example.com
# Who may reach the admin console (/admin, /realms/master): space-separated
# IPv4 and IPv6 CIDRs. Everyone else gets a 404. On a server, list only real
# client addresses — never Docker's internal ranges (172.16.0.0/12, fd00::/8).
ADMIN_ALLOWED_IPS=203.0.113.10/32 2001:db8:1234::/48

# --- Database: external managed Postgres -----------------------------------
# Supabase -> Connect. Pick one:
#  - Direct connection, when this host has IPv6 (the address is IPv6-only).
#    Check: timeout 5 bash -c 'exec 3<>/dev/tcp/db.<project-ref>.supabase.co/5432' && echo ok
#      DB_HOST=db.<project-ref>.supabase.co     DB_USER=postgres
#  - Session pooler, for IPv4-only hosts:
#      DB_HOST=aws-<n>-<region>.pooler.supabase.com   DB_USER=postgres.<project-ref>
# Never the Transaction pooler (port 6543): Keycloak keeps its own connection
# pool and relies on prepared statements.
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
# Must exist before the first start (SQL Editor: create schema keycloak;).
# Never "public" on Supabase — that schema is exposed through its REST API.
DB_SCHEMA=keycloak
DB_JDBC_PARAMS=sslmode=require
DB_POOL_MAX_SIZE=10

# --- Temporary admin --------------------------------------------------------
# Created only on the very first start, while the database is empty. Log in,
# create a permanent admin, delete this one. After that both values are
# ignored, but keep them set: an empty value stops Keycloak from starting.
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
