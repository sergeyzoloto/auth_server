# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Public endpoint -------------------------------------------------------
# DNS name of the auth server. Its A/AAAA record must already point at this
# host before the first start, or Let's Encrypt can't issue the certificate.
AUTH_HOSTNAME=auth.example.com
# Let's Encrypt account email (expiry and problem notices).
ACME_EMAIL=ops@example.com
# Who may reach the admin console (/admin, /realms/master): space-separated
# CIDRs. Everyone else gets a 404.
ADMIN_ALLOWED_IPS=203.0.113.10/32

# --- Database: external managed Postgres -----------------------------------
# Supabase: Project Settings -> Database -> Connection pooling, *Session* mode
# (port 5432). Not Transaction mode (6543): Keycloak keeps its own connection
# pool and relies on prepared statements.
DB_HOST=aws-1-eu-central-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
# Pooler usernames are postgres.<project-ref>, not plain "postgres".
DB_USER=postgres.your-project-ref
DB_PASSWORD=
# Must exist before the first start (SQL Editor: create schema keycloak;).
# Never "public" on Supabase — that schema is exposed through its REST API.
DB_SCHEMA=keycloak
DB_JDBC_PARAMS=sslmode=require
DB_POOL_MAX_SIZE=10

# --- Temporary admin --------------------------------------------------------
# Created only on the very first start, while the database is empty. Log in,
# create a permanent admin, delete this one. After that both values are
# ignored, but keep them set: an empty value stops Keycloak from starting.
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
