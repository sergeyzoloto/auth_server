{
  "realm": "myapps",
  "enabled": true,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Base role shared by every project in this realm"
      }
    ],
    "client": {
      "shop-api": [
        {
          "name": "user"
        },
        {
          "name": "admin"
        }
      ],
      "blog-api": [
        {
          "name": "user"
        },
        {
          "name": "admin"
        }
      ],
      "admin-app": [
        {
          "name": "user"
        },
        {
          "name": "admin"
        }
      ],
      "finance-tracker": [
        {
          "name": "user",
          "description": "Uses Finance Tracker: own categories, transactions and dashboard"
        },
        {
          "name": "admin",
          "description": "Reserved for Finance Tracker admin features; grants nothing yet"
        }
      ]
    }
  },
  "clients": [
    {
      "clientId": "shop-api",
      "enabled": true,
      "publicClient": false,
      "secret": "shop-api-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "blog-api",
      "enabled": true,
      "publicClient": false,
      "secret": "blog-api-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "admin-app",
      "enabled": true,
      "publicClient": false,
      "secret": "admin-app-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "finance-tracker",
      "enabled": true,
      "publicClient": false,
      "secret": "finance-tracker-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/login/oauth2/code/keycloak",
        "http://localhost:5173/login/oauth2/code/keycloak"
      ],
      "webOrigins": [],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:3000/##http://localhost:5173/",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "finance-tracker audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "finance-tracker",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "testuser",
      "enabled": true,
      "emailVerified": true,
      "email": "testuser@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "test1234",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ],
      "clientRoles": {
        "shop-api": [
          "user"
        ],
        "finance-tracker": [
          "user"
        ]
      },
      "firstName": "Test",
      "lastName": "User",
      "requiredActions": []
    }
  ]
}
